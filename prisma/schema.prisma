generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminAuth {
  CONFIRMATION
  OTP
}

enum VerificationType {
  CONFIRMATION_AUTH
  OTP_AUTH
  OTP_ACTION
  CONFIRMATION_ACTION
}

enum TechType {
  BACKEND
  FRONTEND
  FULL_STACK
  DATABASE
  STATIC
  UNKNOWN
}

model Profile {
  id        String  @id @default(cuid())
  name      String
  bio       String
  location  String?
  avatarUrl String

  admins   Admin[]
  projects Project[]
  socials  Social[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  auth       AdminAuth @default(CONFIRMATION)
  allowEmail DateTime  @default(now())

  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String

  @@index([profileId])
}

model Project {
  id          String    @id @default(cuid())
  title       String
  description String
  repoUrl     String?
  demoUrl     String?
  thumbnail   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isRecycled  Boolean   @default(false)
  deleteAt    DateTime?
  techStack   Tech[]

  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String

  @@index([profileId])
}

model Tech {
  id         String    @id @default(cuid())
  name       String
  type       TechType
  url        String
  isRecycled Boolean   @default(false)
  deleteAt   DateTime?

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  @@index([projectId])
  @@index([type])
}

model Social {
  id         String    @id @default(cuid())
  provider   String
  url        String
  isRecycled Boolean   @default(false)
  deleteAt   DateTime?

  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String

  @@index([profileId])
}

model Verification {
  id      String           @id @default(cuid())
  type    VerificationType
  secret  String
  expires DateTime
  info    String           @default("")

  @@index([type])
  @@index([expires])
}

model Revoked {
  id      String   @id @default(cuid())
  type    String
  value   String
  expires DateTime

  @@index([value])
  @@index([expires])
}
